+//-----------------------------------------------------------------------------
+// Wine's DXGI/DXVK path does not implement CreateSwapChainForComposition.
+// VSTGUI's DirectComposition visual then paints a black child HWND. Skip
+// DComp under Wine so the HWND software D2D renderer (BitBlt) is used.
+static bool runningUnderWine ()
+{
+	HMODULE ntdll = GetModuleHandleA ("ntdll.dll");
+	return ntdll && GetProcAddress (ntdll, "wine_get_version") != nullptr;
+}
