+//-----------------------------------------------------------------------------
+// MONKSYNTH_GDI: create a device context backed by a Direct2D DC render target.
+// Wine renders that into an offscreen GDI-compatible surface and BitBlts it onto
+// the HDC it is bound to, so no DXGI swapchain is created for the editor's child
+// window. Each Win32Frame owns one and binds it to the HDC from BeginPaint on
+// every paint.
+PlatformGraphicsDeviceContextPtr Win32Factory::createDCGraphicsDeviceContext () const noexcept
+{
+	// Wine only accepts B8G8R8A8_UNORM with premultiplied or ignored alpha for DC
+	// render targets, so the format cannot be left as UNKNOWN here.
+	auto properties = D2D1::RenderTargetProperties (
+		D2D1_RENDER_TARGET_TYPE_SOFTWARE,
+		D2D1::PixelFormat (DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED), 96.f, 96.f,
+		D2D1_RENDER_TARGET_USAGE_GDI_COMPATIBLE);
+	COM::Ptr<ID2D1DCRenderTarget> dcRenderTarget;
+	if (FAILED (getD2DFactory ()->CreateDCRenderTarget (&properties, dcRenderTarget.adoptPtr ())))
+		return nullptr;
+
+	COM::Ptr<ID2D1DeviceContext> deviceContext;
+	if (FAILED (dcRenderTarget->QueryInterface (
+			__uuidof (ID2D1DeviceContext), reinterpret_cast<void**> (deviceContext.adoptPtr ()))))
+		return nullptr;
+
+	COM::Ptr<ID2D1Device> d2ddevice;
+	deviceContext->GetDevice (d2ddevice.adoptPtr ());
+	auto device = impl->graphicsDeviceFactory.find (d2ddevice.get ());
+	if (!device)
+	{
+		impl->graphicsDeviceFactory.addDevice (
+			std::make_shared<D2DGraphicsDevice> (d2ddevice.get ()));
+		device = impl->graphicsDeviceFactory.find (d2ddevice.get ());
+		vstgui_assert (device);
+	}
+
+	return std::make_shared<D2DGraphicsDeviceContext> (
+		*std::static_pointer_cast<D2DGraphicsDevice> (device).get (), deviceContext.get (),
+		TransformMatrix {});
+}
