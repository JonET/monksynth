+//-----------------------------------------------------------------------------
+// MONKSYNTH_GDI: paint through a Direct2D DC render target. Wine renders that
+// into an offscreen GDI-compatible surface and BitBlts it onto the bound HDC,
+// so no DXGI swapchain is created for the editor's child window. Binding
+// recreates the target bitmap, so the caller must redraw the whole frame
+// whenever the HDC or client rect changes.
+PlatformGraphicsDeviceContextPtr
+	Win32Factory::createDCGraphicsDeviceContext (void* hdc, const CRect& size) const noexcept
+{
+	auto paintDC = reinterpret_cast<HDC> (hdc);
+	if (!paintDC)
+		return nullptr;
+
+	if (!impl->dcRenderTarget)
+	{
+		// Wine only accepts B8G8R8A8_UNORM with premultiplied or ignored alpha
+		// for DC render targets, so the format cannot be left as UNKNOWN here.
+		auto properties = D2D1::RenderTargetProperties (
+			D2D1_RENDER_TARGET_TYPE_SOFTWARE,
+			D2D1::PixelFormat (DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED), 96.f,
+			96.f, D2D1_RENDER_TARGET_USAGE_GDI_COMPATIBLE);
+		if (FAILED (getD2DFactory ()->CreateDCRenderTarget (&properties,
+														   impl->dcRenderTarget.adoptPtr ())))
+		{
+			impl->dcRenderTarget.reset ();
+			return nullptr;
+		}
+		impl->boundDC = nullptr;
+		SetRectEmpty (&impl->boundRect);
+	}
+
+	RECT bindRect {static_cast<LONG> (size.left), static_cast<LONG> (size.top),
+				   static_cast<LONG> (size.right), static_cast<LONG> (size.bottom)};
+	if (impl->boundDC != paintDC || !EqualRect (&impl->boundRect, &bindRect))
+	{
+		if (FAILED (impl->dcRenderTarget->BindDC (paintDC, &bindRect)))
+			return nullptr;
+		impl->dcRenderTarget->SetDpi (96, 96);
+		impl->boundDC = paintDC;
+		impl->boundRect = bindRect;
+	}
+
+	if (impl->dcDeviceContext)
+		return impl->dcDeviceContext;
+
+	COM::Ptr<ID2D1DeviceContext> deviceContext;
+	if (FAILED (impl->dcRenderTarget->QueryInterface (
+			__uuidof (ID2D1DeviceContext), reinterpret_cast<void**> (deviceContext.adoptPtr ()))))
+		return nullptr;
+
+	ID2D1Device* d2ddevice {};
+	deviceContext->GetDevice (&d2ddevice);
+	auto device = impl->graphicsDeviceFactory.find (d2ddevice);
+	if (!device)
+	{
+		impl->graphicsDeviceFactory.addDevice (std::make_shared<D2DGraphicsDevice> (d2ddevice));
+		device = impl->graphicsDeviceFactory.find (d2ddevice);
+		vstgui_assert (device);
+	}
+
+	impl->dcDeviceContext = std::make_shared<D2DGraphicsDeviceContext> (
+		*std::static_pointer_cast<D2DGraphicsDevice> (device).get (), deviceContext.get (),
+		TransformMatrix {});
+	return impl->dcDeviceContext;
+}
